void shellSort(vector<int>& array)
{
    int n = array.size();

    for (int gap = n / 2; gap > 0; gap /= 2)
    {
        for (int i = gap; i < n; i++)
        {
            int value = array[i];
            int j = i;

            while (j >= gap && array[j - gap] > value)
            {
                array[j] = array[j - gap];
                j -= gap;
            }

            array[j] = value;
        }
    }
}

