x = np.linspace(0.75, 3, 1200)
k = np.argmin(abs(x - 1))

y0 = np.zeros_like(x)

def f_pic(x, y):
    return np.exp(-y) / (2*y + x*np.exp(-y))

def cumtrapz_py(y, x):
    dx = np.diff(x)
    area = (y[:-1] + y[1:]) / 2 * dx
    return np.concatenate(([0], np.cumsum(area)))

Yp = np.zeros((4, len(x)))

Yp[0] = cumtrapz_py(f_pic(x, y0), x)
Yp[0] = Yp[0] - Yp[0, k]

for n in range(1, 4):
    Yp[n] = cumtrapz_py(f_pic(x, Yp[n-1]), x)
    Yp[n] = Yp[n] - Yp[n, k]

plt.figure()
plt.plot(x, y0, 'k--', linewidth=1.2)
plt.plot(x, Yp[0], linewidth=1.5)
plt.plot(x, Yp[1], linewidth=1.5)
plt.plot(x, Yp[2], linewidth=1.5)
plt.plot(x, Yp[3], linewidth=1.5)
plt.grid(True)
plt.show()

