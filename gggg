import java.util.Scanner;

public class Variant7 {

    static String text;
    static boolean palindrome;

    // Model
    static void model(String value) {
        text = value;
        palindrome = isPalindrome(text);
    }

    // Check palindrome
    static boolean isPalindrome(String value) {

        for (int i = 0; i < value.length() / 2; i++) {

            if (value.charAt(i) != value.charAt(value.length() - 1 - i)) {
                return false;
            }
        }

        return true;
    }

    // View
    static void view(String message) {
        System.out.println(message);
    }

    // Controller
    static void controller() {

        Scanner scanner = new Scanner(System.in);

        view("Enter string:");
        String input = scanner.nextLine();

        if (!input.matches("[a-zA-Z0-9]+")) {
            view("Wrong input");
            return;
        }

        model(input);

        if (palindrome) {
            view("Palindrome");
        } else {
            view("Not palindrome");
        }

        if (input.matches("[0-9]+") && palindrome) {

            try {

                long number = Long.parseLong(input);

                if (number > 0) {

                    long square = number * number;

                    view("Square = " + square);

                    if (isPalindrome(Long.toString(square))) {
                        view("Square is palindrome");
                    } else {
                        view("Square is not palindrome");
                    }
                }

            } catch (NumberFormatException e) {
                view("Number is too big");
            }
        }
    }

    public static void main(String[] args) {
        controller();
    }
}
