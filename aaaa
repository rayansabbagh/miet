#include <iostream>
using namespace std;

class Account {
    int number;
    float money;

public:

    Account(int number, float money) {
        this->number = number;
        this->money = money;
    }

    bool transferFromAccountTo(Account* pTo, float money) {
        if (this->getCash(money)) {
            pTo->putMoney(money);
            return true;
        }
        return false;
    }

    bool getCash(float money) {
        if (money < this->money) {
            this->money -= money;
            return true;
        }
        return false;
    }

    bool putMoney(float money) {
        if (money > 0) {
            this->money += money;
            return true;
        }
        return false;
    }

    float getMoney() {
        return this->money;
    }

    void setMoney(float money) {
        this->money = money;
    }

    int getNumber() {
        return this->number;
    }

    void setNumber(int number) {
        this->number = number;
    }
};

int main() {

    Account ac(100, 1000), To(200, 500);

    cout << ac.getMoney() << endl;

    ac.putMoney(333);
    cout << ac.getMoney() << endl;

    ac.getCash(222);
    cout << ac.getMoney() << endl;

    ac.transferFromAccountTo(&To, 200);
    cout << ac.getMoney() << endl;
    cout << To.getMoney() << endl;

    ac.setMoney(1337);
    cout << ac.getMoney() << endl;

    cout << ac.getNumber() << endl;

    ac.setNumber(777);
    cout << ac.getNumber() << endl;

    return 0;
}
