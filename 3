import numpy as np
import matplotlib.pyplot as plt

u = np.linspace(-2, 2, 100)
v = np.linspace(0, 2*np.pi, 100)

U, V = np.meshgrid(u, v)

X = U*np.cos(V)
Y = U*np.sin(V)
Z = 3*V

fig = plt.figure()
ax = fig.add_subplot(111, projection='3d')

ax.plot_surface(X, Y, Z, alpha=0.8)

u0 = 1
v0 = np.pi / 2

x0 = u0*np.cos(v0)
y0 = u0*np.sin(v0)
z0 = 3*v0

xp = np.linspace(-1, 1, 30)
yp = np.linspace(0, 2, 30)

XP, YP = np.meshgrid(xp, yp)
ZP = 3*np.pi/2 - 3*XP

ax.plot_surface(XP, YP, ZP, alpha=0.5)
ax.scatter(x0, y0, z0, color='r', s=60)

plt.show()
