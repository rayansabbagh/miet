package lab1;

import java.util.Scanner;

public class Variant1 {

    static class Model {
        int min = 1, max = 100, steps = 0;

        int guess() {
            steps++;
            return (min + max) / 2;
        }

        void update(int answer, int guess) {
            if (answer == 1) min = guess + 1;
            if (answer == 2) max = guess - 1;
        }

        boolean isCheating() {
            return min > max;
        }
    }

    static class View {
        void showRules() {
            System.out.println("Think of an integer from 1 to 100.");
            System.out.println("1 - greater, 2 - smaller, 3 - correct");
        }

        void showGuess(int guess) {
            System.out.print("Is your number " + guess + "? ");
        }
    }

    static class Controller {
        Model model = new Model();
        View view = new View();
        Scanner scanner = new Scanner(System.in);

        int readAnswer() {
            while (true) {
                try {
                    int answer =
                            Integer.parseInt(scanner.nextLine());

                    if (answer >= 1 && answer <= 3)
                        return answer;

                } catch (NumberFormatException exception) {
                }

                System.out.print(
                        "Error! Enter 1, 2 or 3: ");
            }
        }

        void start() {
            view.showRules();

            while (true) {
                int guess = model.guess();
                view.showGuess(guess);
                int answer = readAnswer();

                if (answer == 3) {
                    System.out.println(
                            "Number guessed in "
                            + model.steps + " steps.");
                    return;
                }

                model.update(answer, guess);

                if (model.isCheating()) {
                    System.out.println(
                            "Your answers contradict each other. "
                            + "You are cheating!");
                    return;
                }
            }
        }
    }

    public static void main(String[] args) {
        new Controller().start();
    }
}
