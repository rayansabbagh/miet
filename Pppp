float PensionerBuyer::calculateDiscount(Product product) const {
    time_t now = time(0);
    tm* ltm = localtime(&now);
    int hour = ltm->tm_hour;

    if (hour >= startHour && hour < endHour)
        return baseDiscount + additionalDiscount;

    return baseDiscount;
}

VipBuyer::VipBuyer() : Buyer() {
    favoriteProducts = NULL;
    favoriteCount = 0;
    additionalDiscount = 0;
}

VipBuyer::VipBuyer(const char* firstName, const char* lastName, const char* phone,
                   float baseDiscount, int* favoriteProducts, int favoriteCount, float additionalDiscount)
    : Buyer(firstName, lastName, phone, baseDiscount) {
    this->favoriteCount = favoriteCount;
    this->favoriteProducts = new int[favoriteCount];

    for (int i = 0; i < favoriteCount; i++)
        this->favoriteProducts[i] = favoriteProducts[i];

    this->additionalDiscount = additionalDiscount;
}

VipBuyer::~VipBuyer() {
    delete[] favoriteProducts;
}

void VipBuyer::setFavoriteProducts(int* favoriteProducts, int favoriteCount) {
    delete[] this->favoriteProducts;

    this->favoriteCount = favoriteCount;
    this->favoriteProducts = new int[favoriteCount];

    for (int i = 0; i < favoriteCount; i++)
        this->favoriteProducts[i] = favoriteProducts[i];
}

void VipBuyer::setAdditionalDiscount(float additionalDiscount) {
    if (additionalDiscount >= 0)
        this->additionalDiscount = additionalDiscount;
}

int* VipBuyer::getFavoriteProducts() const {
    return favoriteProducts;
}

int VipBuyer::getFavoriteCount() const {
    return favoriteCount;
}

float VipBuyer::getAdditionalDiscount() const {
    return additionalDiscount;
}

bool VipBuyer::isFavoriteProduct(int code) const {
    for (int i = 0; i < favoriteCount; i++) {
        if (favoriteProducts[i] == code)
            return true;
    }
    return false;
}

char* VipBuyer::getBuyerCategory() const {
    return (char*)"VIP buyer";
}

float VipBuyer::calculateDiscount(Product product) const {
    if (isFavoriteProduct(product.getCode()))
        return baseDiscount + additionalDiscount;

    return baseDiscount;
}

Product* findProduct(Product* products, int count, int code) {
    for (int i = 0; i < count; i++) {
        if (products[i].getCode() == code)
            return &products[i];
    }
    return NULL;
}

void printDateTime() {
    time_t now = time(0);
    tm* ltm = localtime(&now);

    cout << 1900 + ltm->tm_year << ".";
    cout << 1 + ltm->tm_mon << ".";
    cout << ltm->tm_mday << " ";
    cout << ltm->tm_hour << ":";
    cout << ltm->tm_min << ":";
    cout << ltm->tm_sec;
}

void printDiscount(Buyer* buyer, Product product) {
    Category category = product.getCategory();

    printDateTime();
    cout << " ";
    cout << buyer->getFirstName() << " " << buyer->getLastName() << " ";
    cout << buyer->getBuyerCategory() << " ";
    cout << category.getCode() << " ";
    cout << category.getName() << " ";
    cout << product.getCode() << " ";
    cout << product.getName() << " ";
    cout << buyer->calculateDiscount(product) << "%" << endl;
}

void printFinalCost(Buyer* buyer, Product product) {
    Category category = product.getCategory();

    printDateTime();
    cout << " ";
    cout << buyer->getFirstName() << " " << buyer->getLastName() << " ";
    cout << buyer->getBuyerCategory() << " ";
    cout << category.getCode() << " ";
    cout << category.getName() << " ";
    cout << product.getCode() << " ";
    cout << product.getName() << " ";
    cout << product.getBaseCost() << " ";
    cout << buyer->calculateFinalCost(product) << endl;
}

