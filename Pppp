def f(params):
    x, y = params
    return x**2 + y**2 - 2*x + 3*y

def constraint(params):
    x, y = params
    return x**2 + y**2 - 2*x*y - 5

cons = ({'type': 'eq', 'fun': constraint})

start_points = [[0, -2], [-2, 0], [2, 0], [0, 2]]
results = []

for start in start_points:
    res_min = minimize(f, start, constraints=cons)

    if res_min.success:
        results.append((res_min.x[0], res_min.x[1], res_min.fun, 'Условный минимум'))

unique_results = []
for r in results:
    if not any(np.allclose([r[0], r[1]], [u[0], u[1]], atol=1e-3) for u in unique_results):
        unique_results.append(r)

print(f"{'x':>10} | {'y':>10} | {'z':>10} | {'Тип'}")
print("-" * 50)

for x_val, y_val, z_val, kind in unique_results:
    print(f"{x_val:10.4f} | {y_val:10.4f} | {z_val:10.4f} | {kind}")

fig = plt.figure(figsize=(10, 7))
ax = fig.add_subplot(111, projection='3d')

x_range = np.linspace(-5, 5, 100)
y_range = np.linspace(-5, 5, 100)

X, Y = np.meshgrid(x_range, y_range)
Z = X**2 + Y**2 - 2*X + 3*Y

ax.plot_surface(X, Y, Z, cmap='terrain', alpha=0.5)

t = np.linspace(-5, 5, 300)

x1 = t
y1 = t + np.sqrt(5)
z1 = x1**2 + y1**2 - 2*x1 + 3*y1

x2 = t
y2 = t - np.sqrt(5)
z2 = x2**2 + y2**2 - 2*x2 + 3*y2

ax.plot(x1, y1, z1, color='red', lw=4, label='Линия ограничения')
ax.plot(x2, y2, z2, color='red', lw=4)

for xr, yr, zr, kind in unique_results:
    ax.scatter(xr, yr, zr, color='blue', s=150, edgecolors='black')

ax.set_title("Условные экстремумы (Вариант 8)")
ax.view_init(30, 140)

plt.show()
