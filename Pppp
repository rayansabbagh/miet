using namespace std;

char* copyString(const char* s) {
    char* p = new char[strlen(s) + 1];
    strcpy(p, s);
    return p;
}

class Category {
private:
    int code;
    char* name;

public:
    Category();
    Category(int code, const char* name);
    Category(const Category& other);
    ~Category();

    Category& operator=(const Category& other);

    void setCode(int code);
    void setName(const char* name);

    int getCode() const;
    char* getName() const;
};

class Product {
private:
    int code;
    char* name;
    float baseCost;
    Category category;

public:
    Product();
    Product(int code, const char* name, float baseCost, Category category);
    Product(const Product& other);
    ~Product();

    Product& operator=(const Product& other);

    void setCode(int code);
    void setName(const char* name);
    void setBaseCost(float baseCost);
    void setCategory(Category category);

    int getCode() const;
    char* getName() const;
    float getBaseCost() const;
    Category getCategory() const;
};

class Buyer {
protected:
    char* firstName;
    char* lastName;
    char* phone;
    float baseDiscount;

public:
    Buyer();
    Buyer(const char* firstName, const char* lastName, const char* phone, float baseDiscount);
    virtual ~Buyer();

    void setFirstName(const char* firstName);
    void setLastName(const char* lastName);
    void setPhone(const char* phone);
    void setBaseDiscount(float baseDiscount);

    char* getFirstName() const;
    char* getLastName() const;
    char* getPhone() const;
    float getBaseDiscount() const;

    virtual char* getBuyerCategory() const = 0;
    virtual float calculateDiscount(Product product) const = 0;

    float calculateFinalCost(Product product) const;
};

class RegularBuyer : public Buyer {
public:
    RegularBuyer();
    RegularBuyer(const char* firstName, const char* lastName, const char* phone, float baseDiscount);
    ~RegularBuyer();

    char* getBuyerCategory() const;
    float calculateDiscount(Product product) const;
};

class PensionerBuyer : public Buyer {
private:
    float additionalDiscount;
    int startHour;
    int endHour;

public:
    PensionerBuyer();
    PensionerBuyer(const char* firstName, const char* lastName, const char* phone,
                   float baseDiscount, float additionalDiscount, int startHour, int endHour);
    ~PensionerBuyer();

    void setAdditionalDiscount(float additionalDiscount);
    void setPeriod(int startHour, int endHour);

    float getAdditionalDiscount() const;
    int getStartHour() const;
    int getEndHour() const;

    char* getBuyerCategory() const;
    float calculateDiscount(Product product) const;
};

class VipBuyer : public Buyer {
private:
    int* favoriteProducts;
    int favoriteCount;
    float additionalDiscount;

public:
    VipBuyer();
    VipBuyer(const char* firstName, const char* lastName, const char* phone,
             float baseDiscount, int* favoriteProducts, int favoriteCount, float additionalDiscount);
    ~VipBuyer();

    void setFavoriteProducts(int* favoriteProducts, int favoriteCount);
    void setAdditionalDiscount(float additionalDiscount);

    int* getFavoriteProducts() const;
    int getFavoriteCount() const;
    float getAdditionalDiscount() const;

    bool isFavoriteProduct(int code) const;

    char* getBuyerCategory() const;
    float calculateDiscount(Product product) const;
};

Category::Category() {
    code = 0;
    name = copyString("");
}

Category::Category(int code, const char* name) {
    this->code = code;
    this->name = copyString(name);
}

Category::Category(const Category& other) {
    code = other.code;
    name = copyString(other.name);
}

Category::~Category() {
    delete[] name;
}

Category& Category::operator=(const Category& other) {
    if (this != &other) {
        code = other.code;
        delete[] name;
        name = copyString(other.name);
    }
    return *this;
}

void Category::setCode(int code) {
    this->code = code;
}

void Category::setName(const char* name) {
    delete[] this->name;
    this->name = copyString(name);
}

int Category::getCode() const {
    return code;
}

char* Category::getName() const {
    return name;
}

Product::Product() : category() {
    code = 0;
    name = copyString("");
    baseCost = 0;
}

Product::Product(int code, const char* name, float baseCost, Category category) : category(category) {
    this->code = code;
    this->name = copyString(name);
    this->baseCost = baseCost;
}

Product::Product(const Product& other) : category(other.category) {
    code = other.code;
    name = copyString(other.name);
    baseCost = other.baseCost;
}

Product::~Product() {
    delete[] name;
}

Product& Product::operator=(const Product& other) {
    if (this != &other) {
        code = other.code;
        delete[] name;
        name = copyString(other.name);
        baseCost = other.baseCost;
        category = other.category;
    }
    return *this;
}

void Product::setCode(int code) {
    this->code = code;
}

void Product::setName(const char* name) {
    delete[] this->name;
    this->name = copyString(name);
}

void Product::setBaseCost(float baseCost) {
    if (baseCost >= 0)
        this->baseCost = baseCost;
}

void Product::setCategory(Category category) {
    this->category = category;
}

int Product::getCode() const {
    return code;
}

char* Product::getName() const {
    return name;
}

float Product::getBaseCost() const {
    return baseCost;
}

Category Product::getCategory() const {
    return category;
}

