    cout << "Lab 4 - Spanning Tree Algorithms\n";
    cout << "4 - Question 4\n";
    cout << "6 - Question 6\n";
    cout << "Choose: ";
    cin >> choice;

    if (choice == 4) {
        question4();
    }
    else if (choice == 6) {
