import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import minimize

def f(x, y):
    return 3*np.exp(-x**2 - y**2)*np.sin(3*x)*np.cos(3*y)

def fx(x, y):
    return 3*np.exp(-x**2-y**2)*np.cos(3*y)*(3*np.cos(3*x)-2*x*np.sin(3*x))

def fy(x, y):
    return 3*np.exp(-x**2-y**2)*np.sin(3*x)*(-2*y*np.cos(3*y)-3*np.sin(3*y))

x = np.linspace(-2.5, 2.5, 600)
y = np.linspace(-2.5, 2.5, 600)

X, Y = np.meshgrid(x, y)
Z = f(X, Y)

fig = plt.figure()
ax = fig.add_subplot(111, projection='3d')
ax.plot_surface(X, Y, Z)
plt.show()

def g(p):
    return fx(p[0], p[1])**2 + fy(p[0], p[1])**2

P = []

for a in np.linspace(-2.5, 2.5, 21):
    for b in np.linspace(-2.5, 2.5, 21):
        res = minimize(g, [a, b], method='Nelder-Mead')
        p = res.x
        if -2.5 <= p[0] <= 2.5 and -2.5 <= p[1] <= 2.5:
            if g(p) < 1e-10:
                P.append(p)

P = np.array(P)
P = np.round(P, 3)
P = np.unique(P, axis=0)

print(P)

fig = plt.figure()
ax = fig.add_subplot(111, projection='3d')
ax.plot_surface(X, Y, Z, alpha=0.8)

if len(P) > 0:
    ax.scatter(P[:,0], P[:,1], f(P[:,0], P[:,1]), color='r', s=50)

plt.show()

zmax = np.max(Z)
zmin = np.min(Z)

i1, j1 = np.unravel_index(np.argmax(Z), Z.shape)
i2, j2 = np.unravel_index(np.argmin(Z), Z.shape)

point_max = [X[i1,j1], Y[i1,j1], zmax]
point_min = [X[i2,j2], Y[i2,j2], zmin]

print("zmax =", zmax)
print("zmin =", zmin)
print("point_max =", point_max)
print("point_min =", point_min)

plt.figure()
plt.contourf(X, Y, Z, levels=40)
plt.colorbar()
plt.axis('equal')
plt.grid(True)
plt.show()

plt.figure()
plt.contour(X, Y, Z, levels=40)
plt.grid(True)
plt.axis('equal')

xx = np.linspace(-np.sqrt(1.5), np.sqrt(1.5), 1000)
yy = xx**2 + 1

plt.plot(xx, yy, 'r', linewidth=3)

zz = f(xx, yy)

k1 = np.argmax(zz)
k2 = np.argmin(zz)

plt.plot(xx[k1], yy[k1], 'ko')
plt.plot(xx[k2], yy[k2], 'ko')
plt.show()

point_cond_max = [xx[k1], yy[k1], zz[k1]]
point_cond_min = [xx[k2], yy[k2], zz[k2]]

print("point_cond_max =", point_cond_max)
print("point_cond_min =", point_cond_min)
