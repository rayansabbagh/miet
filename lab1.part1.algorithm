#include <algorithm>
#include <chrono>
#include <iomanip>
#include <iostream>
#include <random>
#include <string>
#include <vector>

using namespace std;
using Clock = chrono::steady_clock;

void insertionSort(vector<int>& a)
{
    for (int i = 1; i < static_cast<int>(a.size()); i++)
    {
        int key = a[i];
        int j = i - 1;

        while (j >= 0 && a[j] > key)
        {
            a[j + 1] = a[j];
            j--;
        }

        a[j + 1] = key;
    }
}

void shellSort(vector<int>& a)
{
    int n = static_cast<int>(a.size());

    for (int gap = n / 2; gap > 0; gap /= 2)
    {
        for (int i = gap; i < n; i++)
        {
            int value = a[i];
            int j = i;

            while (j >= gap && a[j - gap] > value)
            {
                a[j] = a[j - gap];
                j -= gap;
            }

            a[j] = value;
        }
    }
}

vector<int> createArray(int n, mt19937& generator)
{
    uniform_int_distribution<int> distribution(-1000000, 1000000);
    vector<int> a(n);

    for (int& value : a)
    {
        value = distribution(generator);
    }

    return a;
}

double measureTime(
    int n,
    void (*sortFunction)(vector<int>&),
    int repeats,
    mt19937& generator,
    bool& correct)
{
    vector<int> original = createArray(n, generator);
    vector<int> data(n);

    auto copyStart = Clock::now();

    for (int i = 0; i < repeats; i++)
    {
        data = original;
    }

    auto copyFinish = Clock::now();

    auto totalStart = Clock::now();

    for (int i = 0; i < repeats; i++)
    {
        data = original;
        sortFunction(data);
    }

    auto totalFinish = Clock::now();

    correct = is_sorted(data.begin(), data.end());

    double copyTime =
        chrono::duration<double>(copyFinish - copyStart).count();

    double totalTime =
        chrono::duration<double>(totalFinish - totalStart).count();

    double sortTime = (totalTime - copyTime) / repeats;

    return max(0.0, sortTime);
}

void printResults(
    const string& title,
    const vector<int>& sizes,
    void (*sortFunction)(vector<int>&),
    int repeats,
    mt19937& generator)
{
    cout << title << '\n';

    for (int n : sizes)
    {
        bool correct = false;

        double time = measureTime(
            n,
            sortFunction,
            repeats,
            generator,
            correct
        );

        cout << "N = " << n << '\n';

        cout << "Sorting time: "
            << fixed
            << setprecision(9)
            << time
            << " seconds.\n";

        if (correct)
        {
            cout << "Check: sorting completed correctly.\n\n";
        }
        else
        {
            cout << "Check: sorting error.\n\n";
        }
    }
}

int main()
{
    mt19937 generator(8);

    cout << "Laboratory Work No. 1\n";
    cout << "Part 1. Variant 8\n\n";

    printResults(
        "Task 3. Insertion Sort",
        { 1200, 2000, 7500 },
        insertionSort,
        10,
        generator
    );

    printResults(
        "Task 8. Shell Sort",
        { 2400, 4000, 15000 },
        shellSort,
        100,
        generator
    );

    return 0;
}
