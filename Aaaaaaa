import java.util.*;

public class Variant5 {
    static final Scanner IN = new Scanner(System.in);
    static final Random R = new Random();

    enum DroneType { LONG_RANGE, INTERCEPTOR, SCOUT, CARGO, MULTIPURPOSE }
    enum TargetType { TANK, AIR_DEFENSE, SUPPLY, SOLDIER, EARTH_SHELTER, CONCRETE_SHELTER, STRIKE_DRONE }

    static class Drone {
        String name;
        // cruise speed, max speed, fuel range, control range, flight time,
        // drone cost, preparation cost, reusable, normal load, max load,
        // max altitude, preparation time
        double[] p = new double[12];
        DroneType[] priority = new DroneType[3];

        Drone(String name, double... values) {
            this.name = name;
            for (int i = 0; i < 12; i++) p[i] = values[i];
            classify();
        }

        void classify() {
            DroneType[] types = DroneType.values();
            double[] score = {
                p[2] / 10 + p[3] / 10 + p[4] * 10,
                p[1] / 4 + (p[11] <= 15 ? 30 : 0),
                p[3] / 8 + p[4] * 12 + p[10] / 100,
                p[9] * 5 + p[2] / 20 + p[7] * 20,
                p[0] / 10 + p[2] / 20 + p[4] * 5 + p[9]
            };
            for (int i = 0; i < score.length - 1; i++) {
                for (int j = i + 1; j < score.length; j++) {
                    if (score[j] > score[i]) {
                        double s = score[i]; score[i] = score[j]; score[j] = s;
                        DroneType t = types[i]; types[i] = types[j]; types[j] = t;
                    }
                }
            }
            System.arraycopy(types, 0, priority, 0, 3);
        }

        double loadPart(double load) {
            if (p[9] == p[8]) return 0;
            return Math.max(0, Math.min(1, (load - p[8]) / (p[9] - p[8])));
        }

        double speedPart(double speed) {
            if (p[1] == p[0]) return 0;
            return Math.max(0, Math.min(1, (speed - p[0]) / (p[1] - p[0])));
        }

        double effectiveRange(double speed, double load) {
            return p[2] * (1 - 0.40 * speedPart(speed)) * (1 - 0.30 * loadPart(load));
        }

        double effectiveTime(double speed, double load) {
            return p[4] * (1 - 0.35 * speedPart(speed)) * (1 - 0.25 * loadPart(load));
        }

        double technicalCost() {
            double[] rate = {10, 15, 5, 4, 100, 1, 1, 5000, 50, 80, 2, 20};
            double sum = 0;
            for (int i = 0; i < 12; i++) sum += p[i] * rate[i];
            return sum;
        }

        void print() {
            System.out.println("Drone: " + name);
            System.out.println("Priorities: " + priority[0] + ", " + priority[1] + ", " + priority[2]);
            System.out.printf("Range at maximum speed/load: %.1f%n", effectiveRange(p[1], p[9]));
            System.out.printf("Time at maximum speed/load: %.1f%n", effectiveTime(p[1], p[9]));
            System.out.printf("Technical cost: %.1f%n", technicalCost());
        }
    }

    static class DroneDatabase {
        ArrayList<Drone> drones = new ArrayList<Drone>();
        EnumMap<DroneType, Integer> stock = new EnumMap<DroneType, Integer>(DroneType.class);

        DroneDatabase() {
            for (DroneType type : DroneType.values()) stock.put(type, 10);
            for (int i = 0; i < 10; i++) {
                drones.add(new Drone("Long-" + i, 120,180,1200,1000,15,50000,2000,1,15,25,7000,30));
                drones.add(new Drone("Interceptor-" + i, 250,450,400,300,4,60000,2500,1,10,15,6000,10));
                drones.add(new Drone("Scout-" + i, 100,150,800,700,20,40000,1500,1,8,12,9000,20));
                drones.add(new Drone("Cargo-" + i, 90,130,600,400,8,70000,3000,1,80,150,4000,40));
                drones.add(new Drone("Multi-" + i, 150,250,700,600,10,55000,2200,1,35,60,6500,25));
            }
        }

        void add(Drone drone) { drones.add(drone); }
        int available(DroneType type) { return stock.get(type); }

        boolean use(DroneType type, int count) {
            if (available(type) < count) return false;
            stock.put(type, available(type) - count);
            return true;
        }

        void printStock() {
            System.out.println("Database: " + drones.size() + " drones");
            for (DroneType type : DroneType.values())
                System.out.println(type + ": " + available(type));
        }
    }

    static class Target {
        TargetType type;
        int x, y;
        boolean active = true;

        Target(TargetType type, int x, int y) {
            this.type = type; this.x = x; this.y = y;
        }

        double distance() { return Math.hypot(x - 50, y - 1); }

        void move() {
            if (!active || (type != TargetType.TANK && type != TargetType.SOLDIER
                    && type != TargetType.STRIKE_DRONE)) return;
            if (x < 50) x++; else if (x > 50) x--;
            if (y > 1) y--;
        }
    }

    static class Simulation {
        DroneDatabase database;
        ArrayList<Target> targets = new ArrayList<Target>();
        int baseHealth = 100;
        int scoutLife = 3;
        int scoutRestart = 0;

        Simulation(DroneDatabase database) { this.database = database; }

        void addTargets() {
            int count = 5 + R.nextInt(26);
            TargetType[] types = TargetType.values();
            for (int i = 0; i < count; i++) {
                int x, y;
                do {
                    x = 1 + R.nextInt(100);
                    y = 10 + (int)(Math.sqrt(R.nextDouble()) * 91);
                    if (y > 100) y = 100;
                } while (Math.hypot(x - 50, y - 1) < 10);
                targets.add(new Target(types[R.nextInt(types.length)], x, y));
            }
            System.out.println("New targets: " + count);
        }

        DroneType droneFor(TargetType type) {
            switch (type) {
                case TANK: case CONCRETE_SHELTER: return DroneType.LONG_RANGE;
                case AIR_DEFENSE: case STRIKE_DRONE: return DroneType.INTERCEPTOR;
                case SOLDIER: return DroneType.SCOUT;
                default: return DroneType.MULTIPURPOSE;
            }
        }

        int needed(TargetType type) {
            switch (type) {
                case TANK: case CONCRETE_SHELTER: return 3;
                case AIR_DEFENSE: case EARTH_SHELTER: case STRIKE_DRONE: return 2;
                default: return 1;
            }
        }

        boolean scoutCurrent() {
            if (scoutRestart > 0) {
                scoutRestart--;
                if (scoutRestart == 0) scoutLife = 3;
                return false;
            }
            scoutLife--;
            if (scoutLife == 0) scoutRestart = 2;
            return true;
        }

        void processTargets() {
            for (Target target : targets) {
                if (!target.active) continue;
                DroneType type = droneFor(target.type);
                int count = needed(target.type);
                if (database.use(type, count)) {
                    target.active = false;
                    System.out.println(target.type + " defeated by " + count + " " + type);
                }
            }
        }

        void attackBase() {
            for (Target target : targets) {
                if (!target.active) continue;
                target.move();
                double d = target.distance();
                if (target.type == TargetType.TANK && d <= 5) baseHealth -= 20;       // 5 shots
                if (target.type == TargetType.SOLDIER && d <= 1.5) baseHealth -= 1;   // 100 shots
                if (target.type == TargetType.STRIKE_DRONE && d == 0) baseHealth -= 20; // 5 hits
            }
        }

        void run(int steps) {
            for (int step = 1; step <= steps && baseHealth > 0; step++) {
                System.out.println("\nSTEP " + step);
                addTargets();
                if (scoutCurrent()) processTargets();
                else System.out.println("Scout information is outdated. New scout is starting.");
                attackBase();
                System.out.println("Base health: " + baseHealth);
            }
        }
    }

    static Drone readDrone() {
        String[] names = {"Cruise speed", "Maximum speed", "Fuel range", "Control range",
            "Flight time", "Drone cost", "Preparation cost", "Reusable (1/0)",
            "Normal load", "Maximum load", "Maximum altitude", "Preparation time"};
        System.out.print("Name: ");
        String name = IN.nextLine();
        double[] values = new double[12];
        for (int i = 0; i < 12; i++) {
            System.out.print(names[i] + ": ");
            values[i] = IN.nextDouble();
        }
        return new Drone(name, values);
    }

    public static void main(String[] args) {
        DroneDatabase database = new DroneDatabase();
        database.printStock();

        System.out.println("\nADD NEW DRONE");
        Drone drone = readDrone();
        database.add(drone);
        drone.print();

        System.out.println("\nSIMULATION");
        new Simulation(database).run(8);
        IN.close();
    }
}
